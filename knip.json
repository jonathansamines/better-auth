{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  },
  "tags": ["-lintignore"],
  "workspaces": {
    "packages/*": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts!", "!src/adapters/**/test/.tmp", "!src/adapters/**/test/auth.ts"]
    }
  },
  "ignoreWorkspaces": ["demo/**", "docs/**", "e2e/**"]
}
